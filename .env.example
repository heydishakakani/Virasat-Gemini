# Copy this file to .env and fill in your key:  cp .env.example .env
# .env is git-ignored and must NEVER be committed.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Free-tier friendly model. Change if your quota page shows a different one.
GEMINI_MODEL=gemini-2.5-flash

# Hard cap enforced by this server so you never burn through the free tier
# (Gemini free tier is ~20 requests/day). Keep 1-2 below the real limit.
DAILY_LIMIT=18

# true = return canned answers and spend ZERO quota. Use this while building the UI.
MOCK_GEMINI=false

PORT=3000
